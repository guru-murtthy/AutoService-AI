# AutoService AI - Production Environment Template

# Environment & Mode Settings
ENVIRONMENT=production
APP_MODE=pilot            # 'pilot' mode enforces safety while using real DB & AI
DEMO_MODE=false           # Set true for isolated demo businesses
LOG_LEVEL=INFO

PORT=8000
HOST=0.0.0.0

# CORS & Domain Settings (CRITICAL: Do NOT use wildcard * in production)
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
PUBLIC_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# Security (CRITICAL: Must set strong 32-character secret)
JWT_SECRET=production_jwt_secret_key_32_characters_minimum_len
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Persistent PostgreSQL)
DATABASE_URL=postgresql://postgres_user:postgres_password@postgres-host:5432/autoservice_prod

# AI Provider Settings (Gemini Primary)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_production_gemini_api_key
OPENAI_API_KEY=your_production_openai_api_key_optional
AI_TIMEOUT_SECONDS=12.0
AI_MAX_RETRIES=3

# Conway Automaton Integration (Disabled by default in production)
AUTOMATON_ENABLED=false
AUTOMATON_URL=http://localhost:9000
AUTOMATON_API_KEY=your_automaton_secret_key

# Channel Integrations
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=mock_whatsapp_key
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=mock_payment_key

# Safety & Financial Flags
LIVE_TRADING_ENABLED=false
PAYMENTS_ENABLED=false
AUTONOMOUS_SPENDING_ENABLED=false
SELF_MODIFICATION_ENABLED=false

# Financial Safety Limits (₹ INR)
DAILY_SPENDING_LIMIT=500.0
MONTHLY_SPENDING_LIMIT=5000.0
APPROVAL_THRESHOLD=10000.0
