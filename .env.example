# AutoService AI - Environment Variables

# Application Mode
APP_MODE=development
BUSINESS_VALIDATION_MODE=true
LOG_LEVEL=INFO

# Backend API Settings
PORT=8000
HOST=0.0.0.0
JWT_SECRET=super-secret-jwt-key-autoservice-ai-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# Fallback SQLite: sqlite:///./autoservice.db
DATABASE_URL=sqlite:///./autoservice.db
# PostgreSQL option: postgresql://postgres:postgres@localhost:5432/autoservice_db

# AI Provider Settings
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Conway Automaton Settings
AUTOMATON_URL=http://localhost:9000
AUTOMATON_API_KEY=automaton_secret_key_here

# Channel Integration Settings (Mock in development)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=mock_whatsapp_key
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=mock_payment_key

# Financial Safety Limits (in INR ₹)
DAILY_SPENDING_LIMIT=500
MONTHLY_SPENDING_LIMIT=5000
MINIMUM_RESERVE=5000
APPROVAL_THRESHOLD=10000
